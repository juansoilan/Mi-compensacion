{
  "manifest_version": 3,
  "name": "Mi Compensación · Close the day",
  "description": "Close and edit workdays in Mi Compensación with your schedule (the last submission becomes the default). Uses the SSO session already open.",
  "version": "1.7.18",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.micompensacion.com/*",
    "https://micompensacion.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Mi Compensación · Hours",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.micompensacion.com/*",
        "https://micompensacion.com/*"
      ],
      "js": [
        "src/content/boot.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/injected.js",
        "src/content/_modules/*",
        "src/shared/*"
      ],
      "matches": [
        "https://*.micompensacion.com/*",
        "https://micompensacion.com/*"
      ]
    }
  ]
}